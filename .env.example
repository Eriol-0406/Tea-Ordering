# Copy to .env (or set in your host's dashboard) before going live.

# Staff password for the admin console at /admin.html.
# If unset, the server generates one at boot and prints it to the log.
ADMIN_PASSWORD=change-me-before-launch

# Ordering zones (shop + CCACC Innovation Hub) live in config/zones.json.
# These two vars are an optional override for the shop coordinate only.
# RESTAURANT_LAT=3.2158
# RESTAURANT_LNG=101.7290

# Where the SQLite order database lives. Defaults to data/orders.db.
# On a host with ephemeral disks, point this at a mounted volume.
# DATABASE_FILE=/var/data/orders.db

# Number of reverse proxies in front of the app (Cloudflare / nginx / Render = 1).
# Leave 0 when running directly. Wrong value = every customer shares one
# rate-limit bucket, so four orders lock out the whole shop.
TRUST_PROXY=0

# Set true only once a real gateway webhook confirms funds server-side.
PAYMENT_GATEWAY_ENABLED=false

# Shows the developer "Mock GPS" dropdown in checkout. Off in production.
ENABLE_MOCK_GPS=false

# Set to production to hide dev affordances.
NODE_ENV=development

# Supabase Postgres connection string.
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Pick the "Session pooler" / IPv4-compatible URI, NOT the direct connection:
# Render has no IPv6 outbound, so the direct host will fail to connect there.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
